{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "register" ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "status", "active" ],
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "status", "waiting" ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "status", "active" ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "status", "active" ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "status", "done" ],
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "status", "done" ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [ "${CLAUDE_PLUGIN_ROOT}/beacon.js", "remove" ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
